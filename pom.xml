<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.aryankanani</groupId>
	<artifactId>repo-interviewer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<!-- The parent of every module (task 4.1, LLD §2): versions, the BOMs and the test setup live here once.
	     ./mvnw verify in this folder builds and tests all modules, in dependency order. -->
	<packaging>pom</packaging>
	<name>repo-interviewer</name>
	<description>Grounded technical interviews about a candidate's own GitHub repository</description>

	<modules>
		<module>libs/common</module>
		<module>libs/llm</module>
		<module>libs/contracts</module>
		<module>app</module>
	</modules>

	<!-- Versions verified on start.spring.io and Maven Central on 2026-10-25 (see docs/LLD.md §1). -->
	<properties>
		<java.version>21</java.version>
		<spring-ai.version>2.0.2</spring-ai.version>
		<javaparser.version>3.28.2</javaparser.version>
		<jgit.version>7.8.0.202609011348-r</jgit.version>
		<!-- Newest release; built against graphql-java 24.1 while Boot 4.1.2 manages 25.1. Task 1.1 verifies DateTime. -->
		<graphql-java-extended-scalars.version>24.0</graphql-java-extended-scalars.version>
		<archunit.version>1.5.1</archunit.version>
		<!-- Tests tagged "eval" call the real model and cost money: skipped by default, run alone with -Pevals. -->
		<test.groups></test.groups>
		<test.excluded-groups>eval</test.excluded-groups>
		<!-- ./mvnw spring-boot:run starts the dev environment; override with -Dspring-boot.run.profiles=stage.
		     Only affects spring-boot:run: the built jar has no default environment (DECISIONS.md D-015). -->
		<spring-boot.run.profiles>dev</spring-boot.run.profiles>
		<!-- Maven runs spring-boot:run in every module; only app turns it back on (the libraries have no main class). -->
		<spring-boot.run.skip>true</spring-boot.run.skip>
		<!-- The app runs in this folder, not in its module's: application.yml imports .env from the working directory. -->
		<spring-boot.run.workingDirectory>${maven.multiModuleProjectDirectory}</spring-boot.run.workingDirectory>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- This project's libraries: a module names them without a version. -->
			<dependency>
				<groupId>com.aryankanani</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryankanani</groupId>
				<artifactId>llm</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aryankanani</groupId>
				<artifactId>contracts</artifactId>
				<version>${project.version}</version>
			</dependency>

			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.github.javaparser</groupId>
				<artifactId>javaparser-core</artifactId>
				<version>${javaparser.version}</version>
			</dependency>
			<dependency>
				<groupId>org.eclipse.jgit</groupId>
				<artifactId>org.eclipse.jgit</artifactId>
				<version>${jgit.version}</version>
			</dependency>
			<dependency>
				<groupId>com.graphql-java</groupId>
				<artifactId>graphql-java-extended-scalars</artifactId>
				<version>${graphql-java-extended-scalars.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<groups>${test.groups}</groups>
					<excludedGroups>${test.excluded-groups}</excludedGroups>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ./mvnw verify -Pevals: only the @Tag("eval") tests, with real model calls. Ask before running. -->
		<profile>
			<id>evals</id>
			<properties>
				<test.groups>eval</test.groups>
				<test.excluded-groups></test.excluded-groups>
			</properties>
			<build>
				<plugins>
					<!-- Evals read ANTHROPIC_API_KEY from .env, which is in this folder. Normal tests need no .env. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
