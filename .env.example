# Copy to .env (gitignored) and fill in. Spring reads it via spring.config.import in application.yml.
# These values are for the dev environment (./mvnw spring-boot:run). Stage and prod get theirs from real
# environment variables: SPRING_PROFILES_ACTIVE, DB_URL, DB_USER, DB_PASSWORD, OLLAMA_BASE_URL, ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
DB_USER=ri
DB_PASSWORD=ri
# Host port for the compose Postgres. Docker Compose and the app both read it.
DB_PORT=5433
