<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aryankanani</groupId>
		<artifactId>repo-interviewer</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<artifactId>outbox</artifactId>
	<name>outbox</name>
	<!-- Task 4.1 step 4a: the database half of the messaging (was in common), so only the services that write events
	     or consume them idempotently need JPA and a database; the GraphQL gateway has neither. -->
	<description>Transactional outbox and idempotent consumers: OutboxWriter, OutboxRelay, ProcessedEvents</description>

	<dependencies>
		<dependency>
			<groupId>com.aryankanani</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- The trace an event was written in, continued when the relay sends it (task 4.3): the API only, the apps
		     bring the OpenTelemetry bridge -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
