<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.aryankanani</groupId>
		<artifactId>repo-interviewer</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>graphql-gateway</artifactId>
	<name>graphql-gateway</name>
	<!-- Task 4.1 (DECISIONS.md D-026): the GraphQL API in front of analysis-service and interview-service, and the
	     interviewEvents subscriptions' fan-out from Kafka. No database and no model calls of its own (step 4a); it
	     was the module "app" until then. -->
	<description>GraphQL gateway (BFF): the public API over AnalysisApi and InterviewApi, and the subscriptions</description>

	<properties>
		<spring-boot.run.skip>false</spring-boot.run.skip>
	</properties>

	<dependencies>
		<!-- This project's libraries -->
		<dependency>
			<groupId>com.aryankanani</groupId>
			<artifactId>common</artifactId>
		</dependency>
		<dependency>
			<groupId>com.aryankanani</groupId>
			<artifactId>contracts</artifactId>
		</dependency>

		<!-- Spring Boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-graphql</artifactId>
		</dependency>
		<!-- ScrollSubrange in, Window out: GraphQL cursor paging uses Spring Data's types (no JPA here, task 4.1 step 4a;
		     JPA brought this until then). Version managed by Boot. -->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Every GraphQL request carries an RS256 JWT, checked here (task 4.4, DECISIONS.md D-030) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Traces over OTLP (task 4.3): Micrometer Tracing on OpenTelemetry. The exporter starts only when
		     management.opentelemetry.tracing.export.otlp.endpoint is set (application-dev.yml: Jaeger). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<!-- Metrics for Prometheus at /actuator/prometheus (task 4.3): the registry Boot exports to when present -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Phase 2: Spring for Apache Kafka (versions managed by Boot: spring-kafka 4.1.2, kafka-clients 4.2.2) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-kafka</artifactId>
		</dependency>

		<!-- The HTTP clients for analysis-service's AnalysisApi and interview-service's InterviewApi
		     (@ImportHttpServices, task 4.1). No model calls here: chat, embeddings, JGit and JavaParser are the
		     services'. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<!-- GraphQL DateTime scalar -->
		<dependency>
			<groupId>com.graphql-java</groupId>
			<artifactId>graphql-java-extended-scalars</artifactId>
		</dependency>

		<!-- Tests -->
		<dependency>
			<groupId>com.aryankanani</groupId>
			<artifactId>test-support</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-graphql-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-kafka</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- An executable app: repackage builds the fat jar, spring-boot:run starts it. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
